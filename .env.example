# Postgres connection string (Neon in production, PGlite locally via `npm run db:dev`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app
BETTER_AUTH_URL=http://localhost:3000
# Optional: «Identificar con IA» in the scanner (D31). Without it the button doesn't show.
ANTHROPIC_API_KEY=
# Optional: identifications per user in 24 hours (default 150)
AI_IDENTIFY_DAILY_LIMIT=